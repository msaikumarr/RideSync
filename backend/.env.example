PORT=5000
MONGO_URI=mongodb+srv://YOUR_DB_USER:YOUR_DB_PASSWORD@your-cluster.mongodb.net/?appName=Cluster0
JWT_SECRET=replace_with_a_long_random_string_never_reuse_this_value
JWT_EXPIRES_IN=7d
SEPARATION_ALERT_KM=2

# Email provider (for sending OTP emails). Preferred: Brevo's HTTPS API, which
# doesn't suffer the SMTP connection timeouts/blocks that raw SMTP (e.g. Gmail)
# hits from cloud hosts. Get a key at https://app.brevo.com > SMTP & API > API Keys,
# and verify FROM_EMAIL as a sender under Senders & IP.
BREVO_API_KEY=your_brevo_api_key
FROM_EMAIL=your_verified_sender@example.com

# Fallback SMTP settings, used only if BREVO_API_KEY is not set. If neither is
# set, emails are logged to console in development.
# SMTP_PASS must be a Google App Password (Google Account > Security > App
# Passwords), not your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=YOUR_GMAIL_ADDRESS@gmail.com
SMTP_PASS=your_google_app_password

# Frontend URL used in email links (optional)
FRONTEND_URL=https://app.ridesync.example.com

# OTP rate-limiting
MAX_RESET_ATTEMPTS=5
RESET_LOCK_MINUTES=60

