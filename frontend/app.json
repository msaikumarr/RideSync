{
  "expo": {
    "name": "RideSync",
    "slug": "ridesync",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ridesync.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "RideSync needs your location to share it with your trip group.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "RideSync needs your location to share it with your trip group, including in the background."
      }
    },
    "android": {
      "package": "com.ridesync.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4338CA"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiBaseUrl": "http://localhost:5000/api",
      "socketUrl": "http://localhost:5000",
      "eas": {
        "projectId": "593d2f22-791e-4552-a3d6-fce1991f1f8f"
      }
    }
  }
}
